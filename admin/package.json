{
  "name": "ml-admin",
  "version": "0.0.1",
  "private": true,
  "description": "Mack & Lee System Admin — admin.mackandlee.com (Phase -1 shell)",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build:embed": "esbuild src/embed/index.ts --bundle --minify --sourcemap --outfile=dist/embed.js --target=es2020 --platform=browser --format=iife",
    "build:embed:dev": "esbuild src/embed/index.ts --bundle --sourcemap --outfile=dist/embed.js --target=es2020 --platform=browser --format=iife",
    "build": "astro build && npm run build:embed",
    "preview": "astro preview",
    "check": "astro check",
    "pages:dev": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy --project-name=ml-admin"
  },
  "dependencies": {
    "astro": "^5.18.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.7.0",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.90.1"
  }
}
