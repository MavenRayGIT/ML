---
interface Props {
  clientSlug: string;
  clientName: string;
}

const { clientSlug, clientName } = Astro.props;
---

<section
  class="flex flex-col h-full bg-[var(--color-paper)]"
  data-client-slug={clientSlug}
  aria-label="Edit chat"
>
  <header
    class="px-4 py-3 border-b border-[var(--color-line)] flex items-center justify-between"
  >
    <div>
      <p class="text-xs uppercase tracking-wider text-[var(--color-text-soft)]">
        Editing
      </p>
      <p class="text-sm font-medium">{clientName}</p>
    </div>
    <div class="flex items-center gap-2">
      <span
        id="chat-status"
        class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-[var(--color-mute)] text-[var(--color-text-soft)]"
        title="Cloud agent state"
      >
        AGENT: IDLE
      </span>
      <button
        id="chat-reset"
        type="button"
        class="text-[10px] font-mono px-1.5 py-0.5 rounded border border-[var(--color-line)] text-[var(--color-text-soft)] hover:bg-[var(--color-mute)]"
        title="Start a new conversation (forgets the current agent ID)"
      >
        RESET
      </button>
    </div>
  </header>

  <ol
    id="chat-log"
    class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3 text-sm"
    aria-live="polite"
  >
    <li class="text-[var(--color-text-soft)] text-xs">
      <p>
        Type a message to start editing. The first turn provisions a cloud
        agent against the staging branch; follow-ups continue the same
        conversation.
      </p>
    </li>
  </ol>

  <form
    id="chat-form"
    class="border-t border-[var(--color-line)] p-3 flex items-end gap-2"
    autocomplete="off"
  >
    <label class="sr-only" for="chat-input">Message</label>
    <textarea
      id="chat-input"
      name="message"
      rows="2"
      placeholder="Ask the agent to edit a page, or say 'push site' when ready to publish…"
      class="flex-1 resize-none rounded-md border border-[var(--color-line)] px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-ink)]/20"
    ></textarea>
    <button
      id="chat-send"
      type="submit"
      class="inline-flex items-center px-3 py-2 text-sm font-medium bg-[var(--color-ink)] text-[var(--color-paper)] rounded-md hover:bg-[var(--color-ink-soft)] disabled:opacity-60"
    >
      Send
    </button>
  </form>
</section>

<script is:inline define:vars={{ clientSlug }}>
  // Chat panel client. Posts user messages to /api/chat, then opens an
  // EventSource to /api/chat/stream to receive the cloud agent's reply.
  // Persists the agentId in localStorage so reloads keep the same conversation.

  const STORAGE_KEY = `ml-admin:agent:${clientSlug}`;

  const form = /** @type {HTMLFormElement} */ (document.getElementById("chat-form"));
  const input = /** @type {HTMLTextAreaElement} */ (document.getElementById("chat-input"));
  const send = /** @type {HTMLButtonElement} */ (document.getElementById("chat-send"));
  const log = /** @type {HTMLOListElement} */ (document.getElementById("chat-log"));
  const status = /** @type {HTMLSpanElement} */ (document.getElementById("chat-status"));
  const reset = /** @type {HTMLButtonElement} */ (document.getElementById("chat-reset"));

  if (!form || !input || !send || !log || !status || !reset) {
    console.warn("[chat] missing required elements");
  } else {
    let activeStream = /** @type {EventSource | null} */ (null);
    let currentAssistantBubble = /** @type {HTMLElement | null} */ (null);

    function getAgentId() {
      try { return localStorage.getItem(STORAGE_KEY); } catch { return null; }
    }
    function setAgentId(id) {
      try { id ? localStorage.setItem(STORAGE_KEY, id) : localStorage.removeItem(STORAGE_KEY); } catch {}
    }

    function setStatus(label) {
      status.textContent = `AGENT: ${label}`;
    }

    function appendUserBubble(text) {
      const li = document.createElement("li");
      li.className = "self-end max-w-[85%] rounded-md px-3 py-2 bg-[var(--color-ink)] text-[var(--color-paper)] whitespace-pre-wrap break-words";
      li.textContent = text;
      log.appendChild(li);
      log.scrollTop = log.scrollHeight;
    }

    function startAssistantBubble() {
      const li = document.createElement("li");
      li.className = "self-start max-w-[85%] rounded-md px-3 py-2 bg-[var(--color-mute)] text-[var(--color-text)] whitespace-pre-wrap break-words";
      li.textContent = "";
      log.appendChild(li);
      log.scrollTop = log.scrollHeight;
      currentAssistantBubble = li;
      return li;
    }

    function appendNotice(text, tone = "soft") {
      const li = document.createElement("li");
      const colorClass = tone === "error"
        ? "text-[var(--color-accent)]"
        : "text-[var(--color-text-soft)]";
      li.className = `text-xs ${colorClass}`;
      li.textContent = text;
      log.appendChild(li);
      log.scrollTop = log.scrollHeight;
    }

    function closeStream() {
      if (activeStream) {
        activeStream.close();
        activeStream = null;
      }
      currentAssistantBubble = null;
    }

    function openStream(agentId, runId) {
      closeStream();
      const url = `/api/chat/stream?agentId=${encodeURIComponent(agentId)}&runId=${encodeURIComponent(runId)}`;
      const es = new EventSource(url, { withCredentials: true });
      activeStream = es;
      setStatus("CONNECTING");

      es.addEventListener("status", (event) => {
        try {
          const data = JSON.parse(event.data);
          setStatus(String(data.status ?? "RUNNING").toUpperCase());
        } catch { /* ignore malformed status */ }
      });

      es.addEventListener("assistant", (event) => {
        try {
          const data = JSON.parse(event.data);
          const bubble = currentAssistantBubble ?? startAssistantBubble();
          bubble.textContent = (bubble.textContent ?? "") + (data.text ?? "");
          log.scrollTop = log.scrollHeight;
        } catch { /* ignore malformed delta */ }
      });

      es.addEventListener("tool_call", (event) => {
        try {
          const data = JSON.parse(event.data);
          appendNotice(`tool: ${data.name ?? "unknown"} ${data.status ?? ""}`.trim());
        } catch { /* ignore */ }
      });

      es.addEventListener("error", (event) => {
        // SSE "error" is both Cursor's `error` event AND the EventSource
        // browser-level error. EventSource doesn't expose the data field on
        // a connection-level error, so we branch on its presence.
        const data = /** @type {MessageEvent} */ (event).data;
        if (typeof data === "string" && data.length > 0) {
          try {
            const parsed = JSON.parse(data);
            appendNotice(`error: ${parsed.message ?? parsed.code ?? data}`, "error");
          } catch {
            appendNotice(`error: ${data}`, "error");
          }
        }
        if (es.readyState === EventSource.CLOSED) {
          setStatus("DISCONNECTED");
          closeStream();
          send.disabled = false;
        }
      });

      es.addEventListener("result", (event) => {
        try {
          const data = JSON.parse(event.data);
          setStatus(String(data.status ?? "FINISHED").toUpperCase());
        } catch { setStatus("FINISHED"); }
      });

      es.addEventListener("done", () => {
        closeStream();
        send.disabled = false;
        currentAssistantBubble = null;
      });
    }

    async function sendMessage(text) {
      appendUserBubble(text);
      send.disabled = true;
      setStatus("STARTING");

      const agentId = getAgentId();
      let response;
      try {
        response = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({
            clientSlug,
            message: text,
            agentId: agentId ?? undefined,
          }),
        });
      } catch (err) {
        appendNotice(`network error: ${err instanceof Error ? err.message : String(err)}`, "error");
        setStatus("ERROR");
        send.disabled = false;
        return;
      }

      if (!response.ok) {
        let detail = `${response.status} ${response.statusText}`;
        try { detail = (await response.json()).error ?? detail; } catch {}
        // If the saved agentId is stale (404 or 409 etc.), clear it so the
        // next send starts a fresh agent.
        if (response.status === 404 || response.status === 409) setAgentId(null);
        appendNotice(`failed to start: ${detail}`, "error");
        setStatus("ERROR");
        send.disabled = false;
        return;
      }

      let payload;
      try {
        payload = await response.json();
      } catch {
        appendNotice("server returned a non-JSON response", "error");
        setStatus("ERROR");
        send.disabled = false;
        return;
      }

      if (payload.agentId) setAgentId(payload.agentId);
      openStream(payload.agentId, payload.runId);
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      input.value = "";
      sendMessage(text);
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    reset.addEventListener("click", () => {
      closeStream();
      setAgentId(null);
      setStatus("IDLE");
      send.disabled = false;
      appendNotice("Started a new conversation (forgot the previous agent).");
    });

    // Reflect persisted agentId on load so the user knows where they left off.
    if (getAgentId()) appendNotice("Resuming previous conversation. Send a message to continue.");
  }
</script>
