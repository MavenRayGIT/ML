---
/**
 * BlogDetailHero.astro — amber 50/50 hero band for /blog/[...slug].
 *
 * Per Figma reference (`Wireframes` → node 173:59) and follow-up
 * clarification 2026-05-11: the hero is a clean 50/50 split.
 *
 *   ┌──────────────────────────────┬──────────────────────────────┐
 *   │  ← Blog                       │                              │
 *   │  [ACCESS TO NATURE] MAR 14 …  │                              │
 *   │                               │       Post cover photo       │
 *   │  The slow work of access      │   (full-bleed to right edge  │
 *   │                               │       of the viewport)       │
 *   │  Notes from a season with…    │                              │
 *   │                               │                              │
 *   │  (●) By Ken Jacobsen          │                              │
 *   └──────────────────────────────┴──────────────────────────────┘
 *      amber, left content margin     post.image cover, no margin
 *                                     starts at viewport center,
 *                                     ends at viewport right edge
 *
 * The amber band is `data-nav-bg="amber"` so the sticky `Nav`
 * swaps to its amber state (already wired) and the two read as one
 * continuous band on the left half. The photo on the right keeps
 * its own contrast — the eye reads top-nav, amber column, photo
 * column as one composed hero.
 *
 * Mobile (< md): stacks — amber content on top (full width), photo
 * below at 16/9. The split layout only kicks in at md+.
 *
 * Colour tokens (no Figma hex literals — locked 2026-05-11):
 *
 *   amber band              → var(--color-amber)
 *   eyebrow chip background → #ffffff
 *   eyebrow text + meta     → var(--color-green-dark)
 *   pipe separator          → var(--color-cream)
 *   H1 + body + byline      → var(--color-black)
 *
 * Author headshot: hardcoded Ken portrait import — Ken is the only
 * author for now. When the practice adds a second author the
 * schema will gain `authorImage?: image()` and this component will
 * read it via `Astro.props`.
 */

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import kenPortrait from '../../assets/Ken-Jacobsen-Portrait.jpg';

export interface Props {
  title: string;
  category: string;
  date: Date;
  author?: string;
  duration?: string;
  excerpt?: string;
  /** Post cover image — rendered as the right half of the hero. */
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  category,
  date,
  author = 'Ken Jacobsen',
  duration,
  excerpt,
  image,
  imageAlt = '',
} = Astro.props;

const dateLabel = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const dateIso = date.toISOString().slice(0, 10);
---

<header
  class="blog-detail-hero relative w-full bg-amber"
  data-nav-bg="amber"
>
  {/* ===================== Back-to-blog breadcrumb =====================
      Absolutely-positioned in the upper-left of the hero so the image
      column on the right can still go flush to the top of the
      viewport (the page sets `hasHero` on Page.astro so <main> has no
      top padding — the amber band reaches the top, nav floats over
      it, no white flash. Fixed 2026-05-11.)

      `top` clears the fixed Nav (56px below the nav: breakpoint, 74px
      at and above) plus a small breathing gap so the eye reads it as
      a continuous step down from the nav rather than collision.
      `left-margin` matches the page gutter so this link x-aligns with
      the nav logo above it.

      Same type treatment as the eyebrow row inside the content
      column; hover flips to white to match the Nav's amber-state link
      hover convention. */}
  <a
    href="/blog"
    class="
      blog-back-link
      absolute z-10
      top-[72px] nav:top-[88px]
      left-[var(--spacing-margin)]
      -ml-1 inline-flex items-center gap-2
      py-2 pr-2 pl-1
      font-body text-eyebrow font-semibold uppercase tracking-eyebrow
      text-green-dark
      transition-colors duration-quick ease-default
      hover:text-white
      focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black
    "
    aria-label="Back to the blog index"
  >
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path
        d="M9 3 L4.5 7 L9 11"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    Blog
  </a>

  {/* 50/50 grid — amber column already has the section's bg, so we
      only need to render the right column when there's an image.
      `min-height` keeps the band tall enough to feel like a hero
      even on posts with a short excerpt. */}
  <div class="grid grid-cols-1 md:grid-cols-2 md:min-h-[600px]">

    {/* ===================== Left: amber content ===================== */}
    {/* Inner content respects the standard page gutter on the left and
        keeps a comfortable breathing margin on the right so copy
        doesn't kiss the photo. `max-w-[640px]` matches the body
        column on the article below so the H1 sets type that reads
        consistently across the page.

        Top padding has to clear the Nav AND the back-link that sits
        above it — `pt-[140px] nav:pt-[170px]` gives the eyebrow chip
        about 32-40px of breathing room below the back-link's
        baseline. Bottom padding is plain `py-section-sm`. */}
    <div class="flex flex-col justify-center pt-[140px] pb-section-sm nav:pt-[170px]">
      <div class="ml-margin mr-margin md:mr-12 lg:mr-16 max-w-[640px]">

        {/* ----- Eyebrow row -----
            Category is a link to /blog?category=… so clicking it lands
            on the blog landing pre-filtered to that category (2026-05-11
            — user feedback). The filter bar reads `?category=` on
            page-load and applies it via the same client-side filter
            script the dropdown uses.

            `data-reveal="stagger"` runs the three items in as a
            quick 1-2-3 fade-in once the hero crosses the reveal
            threshold (which on this page is always at load since the
            hero is the first thing on screen). See the <style> block
            below for the cascade — pipe+duration are grouped into one
            element so they step in together as item #3. */}
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2" data-reveal="stagger">
          <a
            href={`/blog?category=${encodeURIComponent(category)}`}
            class="
              blog-detail-eyebrow-chip
              inline-flex items-center
              rounded-[2px]
              bg-white
              px-2.5 py-1
              font-body text-eyebrow font-semibold uppercase tracking-eyebrow
              text-green-dark
              transition-colors duration-quick ease-default
              hover:bg-green-dark hover:text-white
              focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black
            "
            aria-label={`See all posts in ${category}`}
          >
            {category}
          </a>

          <span class="font-body text-eyebrow font-semibold uppercase tracking-eyebrow text-green-dark">
            <time datetime={dateIso}>{dateLabel}</time>
          </span>

          {duration && (
            <span class="inline-flex items-center gap-3">
              <span class="font-body text-eyebrow text-cream" aria-hidden="true">|</span>
              <span class="font-body text-eyebrow font-semibold uppercase tracking-eyebrow text-green-dark">
                {duration}
              </span>
            </span>
          )}
        </div>

        {/* ----- Title ----- */}
        {/* `text-h2-lg` (48px) on the narrower left column reads
            cleanly without breaking past the column edge. We don't
            need full `text-hero` (72px) here — the photo half does
            most of the visual heavy lifting. */}
        <h1 class="mt-6 font-display text-h2-lg tracking-display font-bold text-black">
          {title}
        </h1>

        {/* ----- Excerpt ----- */}
        {excerpt && (
          <p class="mt-6 font-body text-body leading-[1.6] text-black">
            {excerpt}
          </p>
        )}

        {/* ----- Author byline ----- */}
        {/* Small headshot (48px) + visible "By <bold-name>" beside it.
            The figure tag wraps so screen readers announce it as a
            single byline unit.

            Headshot crop (2026-05-11 — user feedback "zoom in on
            Ken's headshot so it's cropped to his head/face"): the
            wrapper clips to a 48px circle, the inner <img> is scaled
            up ~1.5× with `object-position` anchored on the upper
            third of the source so the visible disc lands on the face
            rather than the shirt. */}
        <figure class="mt-10 flex items-center gap-3">
          <span class="blog-detail-byline-avatar block h-12 w-12 overflow-hidden rounded-full">
            <Image
              src={kenPortrait}
              alt=""
              widths={[120, 160, 200]}
              sizes="72px"
              class="h-full w-full object-cover"
              style="transform: scale(1.5); transform-origin: 50% 28%;"
            />
          </span>
          <figcaption class="font-body text-body text-black">
            By <span class="font-semibold">{author}</span>
          </figcaption>
        </figure>

      </div>
    </div>

    {/* ===================== Right: cover photo ===================== */}
    {/* Mobile: 16/9 photo stacked below the content (md:hidden parent
        keeps the photo visible at all sizes but adjusts aspect).
        Desktop: fills the full right half of the hero. */}
    {image && (
      <div class="relative aspect-[16/9] md:aspect-auto md:h-full">
        <Image
          src={image}
          alt={imageAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 767px) 100vw, 50vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    )}
  </div>
</header>
