---
/**
 * BlogDetailHero.astro — title block for /blog/[...slug].
 *
 * NOT a full-bleed photo hero. Inspired by the Everlywell post layout
 * referenced 2026-05-11:
 *   - White background, sits inside the standard content margin.
 *   - Eyebrow row: category pill + date + reading time (when present)
 *   - H1: Mona Sans Bold, design's full headline scale.
 *   - Excerpt: text-body-lg below the H1 — sets up the article.
 *   - Author: small row above the cover image — "By Ken Jacobsen".
 *   - Cover image: full-width, ~16:9, sits between the title block and
 *     the body. Drops out cleanly when no image is supplied.
 *
 * The detail page itself owns the layout grid (article + sidebar
 * with TOC/share/promo). This component is purely the title block —
 * it's full-width above the grid so the title doesn't feel cramped.
 */

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionEyebrow from '../ui/SectionEyebrow.astro';

export interface Props {
  title: string;
  category: string;
  date: Date;
  author?: string;
  duration?: string;
  excerpt?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const {
  title,
  category,
  date,
  author = 'Ken Jacobsen',
  duration,
  excerpt,
  image,
  imageAlt = '',
} = Astro.props;

const dateLabel = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);

const dateIso = date.toISOString().slice(0, 10);
---

<header class="bg-white pt-section-xs md:pt-section-sm" data-nav-bg="white">
  <div class="mx-auto w-full max-w-[800px] px-margin">
    {/* Category eyebrow + meta row */}
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-caption">
      <SectionEyebrow color="amber">{category}</SectionEyebrow>
      <time
        datetime={dateIso}
        class="font-body uppercase tracking-eyebrow text-gray-mid"
      >
        {dateLabel}
      </time>
      {duration && (
        <span class="font-body uppercase tracking-eyebrow text-gray-mid">{duration}</span>
      )}
    </div>

    {/* H1 — uses h2-lg scale, not text-hero. Hero scale is reserved
        for HeroFullbleed; on the post page the title should feel
        editorial, not promotional. */}
    <h1 class="mt-6 font-display text-h2-lg tracking-display text-black">
      {title}
    </h1>

    {excerpt && (
      <p class="mt-6 max-w-[720px] font-body text-body-lg leading-[1.6] text-black">
        {excerpt}
      </p>
    )}

    <p class="mt-8 font-body text-body text-gray-mid">
      By <span class="text-black">{author}</span>
    </p>
  </div>

  {image && (
    <div class="mx-auto mt-12 w-full max-w-[1100px] px-margin">
      <Image
        src={image}
        alt={imageAlt}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 768px) 100vw, 1100px"
        class="h-auto w-full rounded-[4px] object-cover"
      />
    </div>
  )}
</header>
