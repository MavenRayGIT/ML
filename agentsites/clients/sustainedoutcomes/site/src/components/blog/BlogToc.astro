---
/**
 * BlogToc.astro — persistent table of contents for /blog/[...slug].
 *
 * Per user direction 2026-05-11 (Everlywell reference): sticky sidebar
 * TOC that highlights the current section as the reader scrolls. The
 * MDX renderer in Astro returns a `headings` array — we receive it as
 * a prop and render only the H2s (one level deep). H3s would clutter
 * the rail; if a post wants H3-level nav later, that's a flag on this
 * component.
 *
 * The MDX content needs slug-id'd headings. `@astrojs/mdx` does that
 * automatically via `rehype-slug` (built into the Astro default
 * rehype pipeline) so anchor links resolve out of the box.
 *
 * Active section: an IntersectionObserver tagged via `data-blog-toc`
 * picks the heading whose section is closest to the top of the
 * viewport and adds `[data-active]` to the matching link.
 *
 * Responsive:
 *   - Desktop (lg ≥ 1024px): sticky rail, lives in the sidebar grid
 *     column. `position: sticky; top: 96px` (cleared by the 74px nav
 *     at rest + a little extra).
 *   - Tablet / mobile: collapses to a `<details>` element above the
 *     article so the reader can pop it open without taking up space.
 *
 * No JS required for the TOC to be functional — it's a list of
 * anchor links. The IntersectionObserver only adds the active
 * highlight; missing it degrades to all-inactive, which is fine.
 */

export interface TocHeading {
  /** Heading text. */
  text: string;
  /** Slug id auto-generated by rehype-slug. */
  slug: string;
  /** 1–6 — only depth=2 is rendered in the rail (H2 only). */
  depth: number;
}

export interface Props {
  headings: TocHeading[];
  /** Heading shown above the list. */
  title?: string;
}

const { headings, title = 'On this page' } = Astro.props;

const h2s = headings.filter((h) => h.depth === 2);
const hasToc = h2s.length > 0;
---

{hasToc && (
  <>
    {/* Desktop sticky rail — sidebar consumer (`BlogPostLayout`) places
        this in the .lg col so it sticks alongside the article. */}
    <nav
      class="blog-toc hidden lg:block"
      data-blog-toc
      aria-label={title}
    >
      <p class="font-body text-caption uppercase tracking-eyebrow font-semibold text-black">
        {title}
      </p>
      <ul class="mt-4 space-y-3 border-l border-gray-light pl-4">
        {h2s.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class="blog-toc-link block font-body text-body-sm leading-[1.4] text-gray-mid transition-colors duration-quick ease-default hover:text-black"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* Tablet/mobile collapsed — sits above the article. */}
    <details class="blog-toc-collapsed mb-8 rounded-[4px] border border-gray-light bg-white lg:hidden">
      <summary class="cursor-pointer list-none px-5 py-4 font-body text-caption uppercase tracking-eyebrow font-semibold text-black">
        {title}
        <span class="float-right transition-transform duration-quick ease-default" aria-hidden="true">▾</span>
      </summary>
      <ul class="px-5 pb-5 pt-1 space-y-2">
        {h2s.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              class="block font-body text-body-sm leading-[1.4] text-black transition-colors duration-quick ease-default hover:text-amber"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </>
)}

<style>
  /* Stickiness moved up to the sidebar wrapper in `[...slug].astro`
     (2026-05-11) so TOC + share + promo banner pin together as one
     block, instead of TOC pinning while the others scroll up *into*
     it. This rule intentionally left empty as a hand-off note. */
  .blog-toc-link[data-active] {
    color: var(--color-black);
    font-weight: 600;
  }
  .blog-toc-link[data-active]::before {
    content: '';
    display: inline-block;
    width: 2px;
    height: 14px;
    background-color: var(--color-amber);
    margin-left: -17px;
    margin-right: 15px;
    vertical-align: middle;
  }

  /* Open details rotates the chevron */
  .blog-toc-collapsed[open] summary span { transform: rotate(180deg); }
</style>

{hasToc && (
  <script is:inline>
    (() => {
      const nav = document.querySelector('[data-blog-toc]');
      if (!nav) return;
      const links = Array.from(nav.querySelectorAll('[data-toc-link]'));
      if (!links.length) return;

      const slugToLink = new Map(
        links.map((l) => [l.getAttribute('data-toc-link'), l])
      );
      const headings = Array.from(
        document.querySelectorAll('article h2[id]')
      );

      function setActive(slug) {
        links.forEach((l) => l.removeAttribute('data-active'));
        const target = slug && slugToLink.get(slug);
        if (target) target.setAttribute('data-active', '');
      }

      if (!('IntersectionObserver' in window) || !headings.length) {
        setActive(headings[0]?.id);
        return;
      }

      let currentSlug = headings[0].id;
      setActive(currentSlug);

      const observer = new IntersectionObserver(
        (entries) => {
          // Use top-of-viewport heuristic: pick the heading whose
          // top is the nearest to (but above) the viewport's upper
          // 25% line.
          const visible = entries
            .filter((e) => e.isIntersecting)
            .map((e) => e.target);

          if (visible.length === 0) {
            // Fall back: find the last heading above the viewport top.
            const above = headings.filter(
              (h) => h.getBoundingClientRect().top < 120
            );
            if (above.length) {
              currentSlug = above[above.length - 1].id;
              setActive(currentSlug);
            }
            return;
          }

          // Of the visible ones, take the topmost in document order.
          visible.sort(
            (a, b) =>
              a.getBoundingClientRect().top - b.getBoundingClientRect().top
          );
          currentSlug = visible[0].id;
          setActive(currentSlug);
        },
        {
          rootMargin: '-96px 0px -60% 0px',
          threshold: [0, 1],
        }
      );

      headings.forEach((h) => observer.observe(h));
    })();
  </script>
)}
