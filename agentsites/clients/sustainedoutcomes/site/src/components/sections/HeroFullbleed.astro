---
/**
 * HeroFullbleed.astro — site hero, three visual variants in one component.
 *
 * Per HANDOFF.md → Component Map → HeroFullbleed + the Amendments
 * (node 141:536 annotations) → "Hero — 3 Variants":
 *
 *   variant="photo-blocks"    Full-bleed photo + dark-green semi-transparent
 *                             bg blocks behind the headline & body. Use when
 *                             photo contrast can't be guaranteed. **HOMEPAGE
 *                             DEFAULT** (decided 2026-05-11).
 *
 *   variant="photo-gradient"  Full-bleed photo + top/bottom gradient overlays
 *                             only. No bg blocks. Use when the photo is dark
 *                             enough to read white text directly.
 *
 *   variant="color-only"      No photo — light gradient background. Text
 *                             switches to black. Use for interior pages /
 *                             where no suitable photo exists.
 *
 * Shared geometry:
 *   - Full viewport height, min-height clamped at 788px (spec).
 *   - Content sits in the lower third, left-aligned, inside max-w-content.
 *   - Photo variants land the nav in its `dark` state via `data-nav-bg`.
 *   - color-only lands the nav in `white`.
 *
 * Photo-blocks bg rendering (refined 2026-05-11):
 *   The per-line dark-green rects used to be CSS `box-decoration-break:
 *   clone` on a span around the text. That technique paints each line
 *   as its own stacked DOM element with `rgba(8,57,40,0.51)`, so any
 *   vertical overlap between adjacent rects compounds the alpha into
 *   visible darker "lens" bands. At the design's tight `0.85` leading,
 *   Mona Sans' 1.2em font content-area guarantees that overlap.
 *
 *   We now paint the blocks as a single SVG behind each text element,
 *   with all rects in a `<g opacity="0.51">`. SVG group opacity is
 *   applied to the FLATTENED union of the group's children — the rects
 *   composite at full alpha into an offscreen buffer first, then the
 *   0.51 is applied once to the union. Overlap inside the group is
 *   invisible because both rects are the same solid colour, so we can
 *   keep the design's tight 0.85 leading and the rects merge into a
 *   single seamless shape that fits each line.
 *
 *   Lines are measured via `Range.getClientRects()` on the text span,
 *   repainted on resize and after `document.fonts.ready` so the rects
 *   track the actual rendered metrics (Mona Sans WOFF2 loads async).
 *   Pure progressive enhancement: if JS is disabled the gradients still
 *   carry enough contrast for white text on the photo.
 *
 * Reveal animation (Corporate_Elegant — ANIMATION.md):
 *   `data-reveal="hero"` on the content stack — eyebrow → H1 → body →
 *   CTAs each fade up 16px in a 100ms stagger. Fires immediately on page
 *   load because the hero is above the fold.
 *
 * Copy & content come from props only — never hardcoded here.
 */

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import SectionEyebrow from '../ui/SectionEyebrow.astro';

export type HeroVariant = 'photo-blocks' | 'photo-gradient' | 'color-only';

export interface HeroCta {
  text: string;
  href: string;
}

export interface Props {
  variant?: HeroVariant;
  /** Optional ALL-CAPS label rendered above the headline. */
  eyebrow?: string;
  headline: string;
  body?: string;
  /** Required for photo variants — imported via `astro:assets`. */
  image?: ImageMetadata;
  /** Alt text for the photo. Empty string for purely-decorative imagery. */
  imageAlt?: string;
  primaryCta?: HeroCta;
  secondaryCta?: HeroCta;
}

const {
  variant = 'photo-blocks',
  eyebrow,
  headline,
  body,
  image,
  imageAlt = '',
  primaryCta,
  secondaryCta,
} = Astro.props;

const hasPhoto = variant !== 'color-only';
const hasBlocks = variant === 'photo-blocks';
const navBg: 'dark' | 'white' = hasPhoto ? 'dark' : 'white';
// Buttons inherit the surface their hero sits on so hover colours
// stay legible: dark surface on photos, light surface on color-only.
const btnSurface: 'dark' | 'light' = hasPhoto ? 'dark' : 'light';
---

<section
  class:list={[
    'hero-fullbleed relative isolate flex w-full flex-col justify-end overflow-hidden',
    !hasPhoto && 'hero-color-bg',
  ]}
  style="min-height: max(100vh, 788px);"
  data-nav-bg={navBg}
>
  {hasPhoto && image && (
    <Image
      src={image}
      alt={imageAlt}
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      widths={[768, 1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  )}

  {hasPhoto && (
    <>
      {/* Top gradient — 342px, dark→transparent, multiply-blended into the
          photo so the nav reads cleanly without dimming the whole image. */}
      <div class="hero-gradient-top pointer-events-none absolute inset-x-0 top-0 -z-10 h-[342px]"></div>
      {/* Bottom gradient — soft dark wash on the lower 40% to pull the
          content stack out of the photo regardless of subject brightness. */}
      <div class="hero-gradient-bottom pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-2/5"></div>
    </>
  )}

  <div
    class:list={[
      'hero-content relative mx-auto w-full max-w-content px-margin pb-section',
      hasPhoto ? 'text-white' : 'text-black',
    ]}
    data-reveal="hero"
  >
    {eyebrow && (
      <SectionEyebrow color={hasPhoto ? 'cream' : 'black'} withLeadRule class="hero-eyebrow mb-8">
        {eyebrow}
      </SectionEyebrow>
    )}

    <h1 class="hero-headline relative isolate font-display max-w-[820px] text-[48px] leading-[0.9] tracking-display md:text-hero">
      {hasBlocks ? (
        <>
          <svg
            class="hero-block-bg pointer-events-none absolute inset-0 h-full w-full"
            aria-hidden="true"
            data-hero-block-bg
            preserveAspectRatio="none"
          ></svg>
          <span class="relative" data-hero-block-text>{headline}</span>
        </>
      ) : headline}
    </h1>

    {body && (
      <p class="hero-body relative isolate mt-6 max-w-[560px] font-body text-body leading-[1.6]">
        {hasBlocks ? (
          <>
            {/* `data-hero-block-mode="block"` tells the SVG painter to
                draw ONE rect spanning the full text bounding box rather
                than per-line. The painter also snaps this rect's TOP
                edge to the headline block's BOTTOM edge so the two
                blocks meet at a single seam (per 2026-05-11 feedback:
                "should be one solid block… should meet, not overlap,
                the block behind the header"). */}
            <svg
              class="hero-block-bg pointer-events-none absolute inset-0 h-full w-full"
              aria-hidden="true"
              data-hero-block-bg
              data-hero-block-mode="block"
              preserveAspectRatio="none"
            ></svg>
            <span class="relative" data-hero-block-text>{body}</span>
          </>
        ) : body}
      </p>
    )}

    {(primaryCta || secondaryCta) && (
      <div class="hero-ctas mt-10 flex flex-wrap items-center gap-4">
        {primaryCta && (
          <Button variant="amber-fill" surface={btnSurface} href={primaryCta.href}>
            {primaryCta.text}
          </Button>
        )}
        {secondaryCta && (
          <Button variant="outline" surface={btnSurface} href={secondaryCta.href}>
            {secondaryCta.text}
          </Button>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero-gradient-top {
    background: linear-gradient(180deg, rgba(5, 8, 3, 0.82) 0%, rgba(5, 8, 3, 0) 100%);
    mix-blend-mode: multiply;
  }
  .hero-gradient-bottom {
    background: linear-gradient(0deg, rgba(5, 8, 3, 0.72) 0%, rgba(5, 8, 3, 0) 100%);
  }
  .hero-color-bg {
    background: linear-gradient(166deg, #ffffff 50.9%, rgba(252, 230, 149, 0.49) 159.4%);
  }
  /* The SVG painter draws its rects in user-space units that match the
     host element's CSS pixel box, padded outward on the X axis. Letting
     the SVG overflow visually keeps the horizontal "block pad" outside
     the host box visible when a line lands at the box edge. */
  .hero-block-bg {
    overflow: visible;
  }
</style>

<script is:inline>
  /* Hero block painter.
   *
   * Replaces CSS `box-decoration-break: clone` rects with an SVG painted
   * behind each `[data-hero-block-text]` span. All rects within one SVG
   * are children of a single `<g opacity="0.51">`, so SVG flattens them
   * into an opaque union before applying the group alpha — overlap
   * between adjacent rects disappears, and we get a seamless merged
   * shape instead of stacked semi-transparent stripes.
   *
   * Modes:
   *   data-hero-block-mode="line"  (default) — one rect per visual line
   *                                 of text, tight to the line box. Used
   *                                 by the headline (tight 0.85 leading
   *                                 lets rects merge into one shape).
   *
   *   data-hero-block-mode="block" — one rect spanning the bounding box
   *                                 of ALL text lines. Used by the body
   *                                 copy whose 1.6 leading would leave
   *                                 visible white gutters between
   *                                 per-line rects. Top edge SNAPS to
   *                                 the previous block's bottom edge so
   *                                 the two read as one continuous
   *                                 piece-of-paper behind eyebrow +
   *                                 headline + body.
   *
   * Lines come from `Range.getClientRects()`, which gives one DOMRect
   * per visual line of the text run, in viewport coords. Subtract the
   * host element's bbox to get host-relative coords for the SVG.
   *
   * Repaint triggers:
   *   - DOMContentLoaded         first paint (system fonts)
   *   - document.fonts.ready     final paint with Mona Sans loaded
   *   - window resize / orient.  rAF-debounced repaint
   *
   * Pure enhancement: with JS off, the gradients on the photo still
   * carry the white text. The SVG stays empty.
   */
  (() => {
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const FILL = '#083928';     /* --color-green-dark */
    const OPACITY = '0.51';     /* matches the original .hero-block alpha */
    const PAD_X_EM = 0.3;       /* horizontal block padding around text */
    const PAD_Y_EM = 0.15;      /* vertical block padding — must cover the
                                   font's content-area beyond the line box.
                                   At lh 0.85, Mona Sans glyphs extend
                                   ~0.175em past the box on each side, so
                                   ≥0.15em gives a clean visual cover with
                                   no glyphs poking through the rect edge. */

    /**
     * For "block" mode: find the previous-in-document hero block's
     * bottom edge in viewport coords. Returns null if there's no
     * earlier block to snap to.
     */
    function findPrevBlockBottom(currentSvg) {
      const all = document.querySelectorAll('[data-hero-block-bg]');
      let prev = null;
      for (const svg of all) {
        if (svg === currentSvg) break;
        prev = svg;
      }
      if (!prev) return null;
      const prevHost = prev.parentElement;
      if (!prevHost) return null;
      const prevHostBox = prevHost.getBoundingClientRect();
      const rects = prev.querySelectorAll('rect');
      if (!rects.length) return null;
      let bottom = -Infinity;
      for (const r of rects) {
        const ry = parseFloat(r.getAttribute('y')) || 0;
        const rh = parseFloat(r.getAttribute('height')) || 0;
        const b = prevHostBox.top + ry + rh;
        if (b > bottom) bottom = b;
      }
      return Number.isFinite(bottom) ? bottom : null;
    }

    function paintBlock(svg) {
      const host = svg.parentElement;
      if (!host) return;
      const textEl = host.querySelector('[data-hero-block-text]');
      if (!textEl) return;

      const cs = getComputedStyle(host);
      const fontSize = parseFloat(cs.fontSize) || 16;
      const padX = PAD_X_EM * fontSize;
      const padY = PAD_Y_EM * fontSize;

      const range = document.createRange();
      range.selectNodeContents(textEl);
      const lines = Array.from(range.getClientRects()).filter((r) => r.width >= 1);

      const hostBox = host.getBoundingClientRect();
      const w = hostBox.width;
      const h = hostBox.height;

      svg.setAttribute('width', String(w));
      svg.setAttribute('height', String(h));
      svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);

      /* Clear and rebuild — cheap; we're talking 1–4 rects per host. */
      while (svg.firstChild) svg.removeChild(svg.firstChild);

      const group = document.createElementNS(SVG_NS, 'g');
      group.setAttribute('fill', FILL);
      group.setAttribute('opacity', OPACITY);

      const mode = svg.dataset.heroBlockMode || 'line';

      if (mode === 'block' && lines.length > 0) {
        /* Bounding box of all lines, in viewport coords. */
        let minLeft = Infinity, maxRight = -Infinity, minTop = Infinity, maxBottom = -Infinity;
        for (const line of lines) {
          if (line.left   < minLeft)   minLeft   = line.left;
          if (line.right  > maxRight)  maxRight  = line.right;
          if (line.top    < minTop)    minTop    = line.top;
          if (line.bottom > maxBottom) maxBottom = line.bottom;
        }

        /* Snap to the previous block's bottom edge if there is one
           (e.g. body snapping under the headline block). Otherwise the
           rect just uses its own padY for the top edge. */
        let rectTopViewport = minTop - padY;
        const prevBottom = findPrevBlockBottom(svg);
        if (prevBottom !== null) {
          rectTopViewport = prevBottom;
        }

        const x  = minLeft - hostBox.left - padX;
        const y  = rectTopViewport - hostBox.top;
        const rw = (maxRight - minLeft) + 2 * padX;
        const rh = (maxBottom + padY) - rectTopViewport;

        const rect = document.createElementNS(SVG_NS, 'rect');
        rect.setAttribute('x', String(x));
        rect.setAttribute('y', String(y));
        rect.setAttribute('width', String(rw));
        rect.setAttribute('height', String(rh));
        group.appendChild(rect);
      } else {
        /* line mode — one rect per visual line of text. */
        for (const line of lines) {
          const x  = line.left - hostBox.left - padX;
          const y  = line.top  - hostBox.top  - padY;
          const rw = line.width  + 2 * padX;
          const rh = line.height + 2 * padY;
          const rect = document.createElementNS(SVG_NS, 'rect');
          rect.setAttribute('x', String(x));
          rect.setAttribute('y', String(y));
          rect.setAttribute('width', String(rw));
          rect.setAttribute('height', String(rh));
          group.appendChild(rect);
        }
      }
      svg.appendChild(group);
    }

    function paintAll() {
      /* DOM order matters — block-mode painters look "up" the list for
         the previous block to snap to, so the headline (rendered first
         in the JSX) MUST paint before the body. `querySelectorAll`
         returns elements in document order, which is what we want. */
      document.querySelectorAll('[data-hero-block-bg]').forEach(paintBlock);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', paintAll);
    } else {
      paintAll();
    }
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(paintAll);
    }

    let pending = 0;
    window.addEventListener('resize', () => {
      if (pending) return;
      pending = requestAnimationFrame(() => {
        pending = 0;
        paintAll();
      });
    });
  })();
</script>
