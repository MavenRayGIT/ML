---
/**
 * BlogPreview.astro — "Latest Insights" 3-card row from the blog.
 *
 * Per HANDOFF.md → Component Map → BlogPreview. The card row used to
 * stagger in from the left (`row-shift`), but per 2026-05-11 review
 * the slide-in felt fussy on this section — cards now render static.
 *
 * Modules are dumb — this component takes a `posts` array via prop.
 * The caller (homepage / blog landing) reads from `astro:content` and
 * passes in the latest N. Lets Step 5 ship before Step 6 (content
 * collection) lands.
 *
 * Layout:
 *   - White bg, standard section padding.
 *   - Centered "Latest Insights" header (Mona Sans Bold 40px).
 *   - 3-col grid of cards: image overflows top, title, body, TextLink.
 *   - Cards: white bg, drop shadow rgba(0,0,0,0.08).
 *   - Mobile: 1-col stack.
 */

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import TextLink from '../ui/TextLink.astro';

export interface BlogPreviewPost {
  title: string;
  excerpt: string;
  image: ImageMetadata;
  imageAlt?: string;
  href: string;
  category?: string;
}

export interface Props {
  /** Defaults to "Latest Insights" per HANDOFF.md. */
  headline?: string;
  posts: BlogPreviewPost[];
  /** Defaults to "Read the article" per HANDOFF.md. */
  linkText?: string;
}

const {
  headline = 'Latest Insights',
  posts,
  linkText = 'Read the article',
} = Astro.props;
---

<section
  class="blog-preview relative w-full bg-white py-section"
  data-nav-bg="white"
>
  <div class="mx-auto w-full max-w-content px-margin">
    <h2 class="font-display text-h2 tracking-display text-center text-black">
      {headline}
    </h2>

    <ul class="blog-preview-grid mt-16 grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-3">
      {posts.map((post) => (
        <li class="blog-card group relative flex flex-col bg-white shadow-[0_8px_24px_rgba(0,0,0,0.08)]">
          {/* Image overflows the top of the card per the HANDOFF spec —
              negative margin-top pulls it up out of the card bounds. */}
          <div class="blog-card-image relative -mt-6 aspect-[4/3] w-full overflow-hidden">
            <Image
              src={post.image}
              alt={post.imageAlt ?? ''}
              widths={[400, 600, 800]}
              sizes="(max-width: 768px) 100vw, 33vw"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="blog-card-body flex flex-1 flex-col p-6">
            {post.category && (
              <p class="font-body text-caption font-semibold uppercase tracking-eyebrow text-amber">
                {post.category}
              </p>
            )}
            <h3 class:list={['font-display text-card-sm tracking-display text-black', post.category && 'mt-3']}>
              <a href={post.href} class="hover:text-amber transition-colors duration-base ease-default">
                {post.title}
              </a>
            </h3>
            <p class="mt-3 flex-1 font-body text-body leading-[1.6] text-black">
              {post.excerpt}
            </p>
            <div class="mt-6">
              <TextLink href={post.href}>{linkText}</TextLink>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
