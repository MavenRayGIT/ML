---
/**
 * BlogPreview.astro — "Latest Insights" 3-card row from the blog.
 *
 * Per HANDOFF.md → Component Map → BlogPreview. The card row used to
 * stagger in from the left (`row-shift`); the slide-in was dropped on
 * 2026-05-11 — cards now render static.
 *
 * As of Step 7 (2026-05-11), the card itself lives in
 * `components/blog/BlogCard.astro` — this component is a thin wrapper
 * that owns the section chrome (bg, header, grid) and hands each post
 * to `BlogCard` for the card-image-contract hover treatment.
 *
 * Modules are dumb — this component takes a `posts` array via prop.
 * The caller (homepage / blog landing) reads from `astro:content` and
 * passes in the latest N. The `BlogCardPost` shape matches what
 * `BlogCard` expects.
 */

import BlogCard, { type BlogCardPost } from '../blog/BlogCard.astro';

export type BlogPreviewPost = BlogCardPost;

export interface Props {
  /** Defaults to "Latest Insights" per HANDOFF.md. */
  headline?: string;
  posts: BlogPreviewPost[];
  /** Defaults to "Read the article" per HANDOFF.md. */
  linkText?: string;
}

const {
  headline = 'Latest Insights',
  posts,
  linkText = 'Read the article',
} = Astro.props;
---

<section
  class="blog-preview relative w-full bg-white py-section"
  data-nav-bg="white"
>
  <div class="mx-auto w-full max-w-content px-margin">
    <h2 class="font-display text-h2 tracking-display text-center text-black">
      {headline}
    </h2>

    <ul class="mt-16 grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-3">
      {posts.map((post) => (
        <li>
          <BlogCard post={post} linkText={linkText} size="lg" />
        </li>
      ))}
    </ul>
  </div>
</section>
