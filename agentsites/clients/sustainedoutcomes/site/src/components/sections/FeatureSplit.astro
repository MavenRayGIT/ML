---
/**
 * FeatureSplit.astro — 50/50 image + text split.
 *
 * Reused on the homepage for:
 *   - Initiative ERB     (image-left,  dark,  angled,  full-bleed image)
 *   - Initiative Oakland (image-right, light, angled,  full-bleed image)
 *   - Founder            (image-left,  light, plain,   CONTAINED image —
 *                         per 2026-05-11 refinement: founder image must
 *                         stay within max-w-content, not run to viewport edge)
 *
 * Layout modes:
 *   default              Image side is flush to the page edge; text side
 *                        sits within standard `px-margin` content margins.
 *   contained=true       Whole section sits within max-w-content; the image
 *                        edge ends at the same gutter as the text.
 *
 * Mobile: stacks to 1-col with the image above the text.
 *
 * Angled treatment (per ANIMATION.md → Angle-grow) — v4 shipped 2026-05-11:
 *
 *   The angled silhouette is not a static decoration — it **develops**
 *   on scroll. The section enters the viewport as a plain rectangle
 *   and carves out its angled wedges as the user scrolls through it.
 *
 *   Mechanics:
 *   - Two polygon vertices are **anchored** at the section's corners
 *     and never move:
 *         top-right  (100%, 0%)
 *         bot-left   (0%,   100%)
 *   - Two polygon vertices are **driven** by per-edge CSS custom
 *     properties and slide inward as the user scrolls:
 *         top-left   (0%,   var(--angle-grow-top))               — slides DOWN from y=0
 *         bot-right  (100%, calc(100% - var(--angle-grow-bot)))  — slides UP   from y=100%
 *
 *   v4 introduces a **staggered active window** for each edge. Each
 *   edge holds flat (0px) until its scroll-progress window starts,
 *   animates (softly eased) to fully-angled across the window, then
 *   holds fully-angled (SLOPE × width) until the section exits the
 *   viewport:
 *
 *     TOP edge:   p < 0.10     →  flat               (brief hold at entry)
 *                 0.10 → 0.30  →  animating          (develops first, 0.20 wide)
 *                 p > 0.30     →  fully angled
 *
 *     BOT edge:   p < 0.35     →  flat               (waits — gives top a beat alone)
 *                 0.35 → 0.45  →  animating          (catches up fast, 0.10 wide)
 *                 p > 0.45     →  fully angled
 *
 *   The bot window is **half** the width of top's, so bot animates
 *   at ~2× top's velocity — reads as top pulling bot along behind
 *   it. The 0.05 gap between TOP_END (0.30) and BOT_START (0.35)
 *   is the "tug" beat: top is fully angled, bot is still flat,
 *   you see the section visibly out-of-balance for a moment before
 *   bot snaps into motion and catches up.
 *
 *   Both edges fully developed by p ≈ 0.45 — i.e. just before the
 *   section reaches centre-screen. After that the section holds at
 *   full angle as it scrolls up and out.
 *
 *   Depth at fully-angled = `SLOPE × section.width` where
 *   `SLOPE = tan(7°) ≈ 0.1228`. Width-relative so the apparent
 *   angle is consistent across viewport sizes:
 *     1280px section → Δ = 157px (calibrated reference)
 *      640px section → Δ = 79px
 *      375px mobile  → Δ = 46px
 *
 *   Because the moving vertices stay strictly inside `0..100%` and
 *   each diagonal pivots around an anchored corner, the lines develop
 *   as continuous straight diagonals — no corner-flatten artefact
 *   (early v2 bug; see git history).
 *
 *   `prefers-reduced-motion: reduce` locks both vars to `12.28vw`
 *   (CSS equivalent of `SLOPE × width` for full-bleed sections, which
 *   all angled FeatureSplits are by design) so reduced-motion users
 *   see the fully-angled silhouette statically.
 *
 *   The v1 one-shot entry reveal (`data-reveal="angle-shift"`) was
 *   intentionally dropped — the scroll-tied motion below now serves
 *   as both the entry effect and the through-scroll effect, so there
 *   is exactly one animation reading at a time. Plain (non-angled)
 *   FeatureSplits still get the standard `data-reveal="header"` block
 *   reveal.
 *
 * Copy & content come from props only.
 */

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import SectionEyebrow from '../ui/SectionEyebrow.astro';

type FeatureCtaVariant = 'amber-fill' | 'green-fill' | 'outline' | 'outline-emph';
type FeatureCtaSurface = 'light' | 'dark' | 'amber';

/**
 * Adjacent-section colour token. Maps 1:1 to the bg classes Tailwind
 * already sees, so static class-name discovery keeps working — no
 * dynamic `bg-${var}` strings.
 */
type SectionBg = 'white' | 'amber' | 'cream' | 'green-dark' | 'gray-light';

const sectionBgClass: Record<SectionBg, string> = {
  white:        'bg-white',
  amber:        'bg-amber',
  cream:        'bg-cream',
  'green-dark': 'bg-green-dark',
  'gray-light': 'bg-gray-light',
};

export interface FeatureSplitCta {
  text: string;
  href: string;
  /** Defaults to the sensible variant for the surface — see frontmatter below. */
  variant?: FeatureCtaVariant;
}

export interface Props {
  eyebrow?: string;
  headline: string;
  body?: string;
  image: ImageMetadata;
  imageAlt?: string;
  imagePosition?: 'left' | 'right';
  /** Dark surface = green-dark bg + white text. Default light. */
  dark?: boolean;
  /** Apply the diagonal clip-path treatment. Used on the two initiatives. */
  angled?: boolean;
  /**
   * Keep both halves inside `max-w-content` rather than running the image
   * to the viewport edge. Founder block uses this. Default false.
   */
  contained?: boolean;
  cta?: FeatureSplitCta;
  /**
   * Adjacent-section blend (angled sections only). The clip-path cuts
   * triangular wedges out of the section's bottom-right and top-left
   * corners — by default those wedges expose the page background
   * (white), which can read as a visible "wedge" between two coloured
   * sections.
   *
   * Set `nextBg` to the bg colour of the section immediately below so
   * the bottom wedge fills with that colour and the angle blends
   * seamlessly into the next section. `prevBg` does the same for the
   * top wedge. Both no-op on non-angled sections.
   *
   * Example: angled dark FeatureSplit followed by VideoSection (amber):
   *   <FeatureSplit dark angled nextBg="amber" ... />
   */
  nextBg?: SectionBg;
  prevBg?: SectionBg;
}

const {
  eyebrow,
  headline,
  body,
  image,
  imageAlt = '',
  imagePosition = 'left',
  dark = false,
  angled = false,
  contained = false,
  cta,
  nextBg,
  prevBg,
} = Astro.props;

const navBg = dark ? 'dark' : 'white';
const ctaSurface: FeatureCtaSurface = dark ? 'dark' : 'light';
const ctaVariant: FeatureCtaVariant = cta?.variant ?? (dark ? 'amber-fill' : 'outline');

// Plain sections use the standard `header` block reveal. Angled
// sections have NO entry data-reveal — the scroll-progress motion
// below drives clip-path directly from the section's viewport
// position, which already serves as the entry effect.
const reveal = angled ? undefined : 'header';
---

{/* Frame wrapper — only used as a host for the angled-wedge blend
    plates (prevBg / nextBg). Without those props the wrapper is inert
    and just passes the section through; we always render it for layout
    consistency and to keep CSS targeting predictable. */}
<div class="feature-split-frame relative">
  {angled && prevBg && (
    <div
      aria-hidden="true"
      class:list={[
        'feature-split-blend pointer-events-none absolute inset-x-0 top-0 h-1/2',
        sectionBgClass[prevBg],
      ]}
    ></div>
  )}
  {angled && nextBg && (
    <div
      aria-hidden="true"
      class:list={[
        'feature-split-blend pointer-events-none absolute inset-x-0 bottom-0 h-1/2',
        sectionBgClass[nextBg],
      ]}
    ></div>
  )}
  <section
    class:list={[
      'feature-split relative z-10 w-full overflow-hidden',
      dark ? 'bg-green-dark text-white' : 'bg-white text-black',
      angled && 'feature-split-angled',
      contained && 'feature-split-contained',
    ]}
    data-nav-bg={navBg}
    data-reveal={reveal}
    data-image-position={imagePosition}
  >
  <div
    class:list={[
      'grid grid-cols-1 md:grid-cols-2',
      contained && 'mx-auto w-full max-w-content px-margin gap-x-12 py-section-sm md:py-section',
    ]}
  >
    {/* Image cell — bleeds to viewport edge in the default layout, sits
        inside the content gutter when `contained`. */}
    <div
      class:list={[
        'feature-split-image relative w-full',
        contained
          ? 'aspect-[4/3] md:aspect-auto md:min-h-[480px]'
          : 'min-h-[320px] md:min-h-[622px]',
        imagePosition === 'right' && 'md:order-2',
      ]}
    >
      <Image
        src={image}
        alt={imageAlt}
        widths={[640, 960, 1280]}
        sizes="(max-width: 768px) 100vw, 50vw"
        class="absolute inset-0 h-full w-full object-cover"
      />
    </div>

    {/* Text cell — content always sits within content margins. The
        `contained` wrapper above already supplies px-margin + section
        padding, so we drop them here in that mode. */}
    <div
      class:list={[
        'feature-split-text flex items-center',
        contained
          ? 'pt-8 md:pt-0 md:pl-4'
          : 'px-margin py-section-sm md:py-section',
      ]}
    >
      <div class="feature-split-content max-w-[520px]">
        {eyebrow && (
          <SectionEyebrow color={dark ? 'amber' : 'black'} withLeadRule class="mb-6">
            {eyebrow}
          </SectionEyebrow>
        )}
        <h2 class="font-display text-h2 tracking-display">{headline}</h2>
        {body && (
          <p class="mt-6 font-body text-body-lg leading-[1.6]">{body}</p>
        )}
        {cta && (
          <div class="mt-8">
            <Button variant={ctaVariant} surface={ctaSurface} href={cta.href}>
              {cta.text}
            </Button>
          </div>
        )}
      </div>
    </div>
  </div>
  </section>
</div>

<style>
  /* Angled silhouette — clip-path "grows" the angle on scroll, with
     per-edge staggered scroll-progress windows.

     Two CSS custom properties drive the two non-anchored polygon
     vertices independently:

       --angle-grow-top  →  drives the top-left vertex (top edge)
       --angle-grow-bot  →  drives the bot-right vertex (bottom edge)

     The inline script writes each variable per frame off scroll
     progress, scaled to section width so the 7° slope stays
     consistent across viewport sizes. Each edge holds at 0 (flat)
     until its scroll-progress window starts, animates linearly to
     `SLOPE × width` across its window, then holds fully-angled.

     Top-right (100%, 0%) and bottom-left (0%, 100%) are anchored at
     the section's corners and never move. The diagonals pivot around
     those anchors as the moving vertices slide inward. Because all
     four vertices stay strictly inside `0%..100%` for the full motion
     range, the diagonals never get kinked against a box edge (= no
     corner-flatten artefact). */
  .feature-split-angled {
    --angle-grow-top: 0px;
    --angle-grow-bot: 0px;
    clip-path: polygon(
      0%   var(--angle-grow-top),
      100% 0%,
      100% calc(100% - var(--angle-grow-bot)),
      0%   100%
    );

    /* GPU compositor layer hints — clip-path animation otherwise
       forces a per-frame re-rasterization of the section content,
       which makes the angled edge's anti-aliasing dance against the
       pixel grid (visible as vibration/flicker during scroll).
       Promoting to a backing texture lets the browser treat the
       clip-path as a cheap mask over a static rasterization. */
    will-change: clip-path;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* Image inside an angled FeatureSplit also needs its own layer —
     the clip-path repaints the section content each frame, and
     without compositor promotion the image is re-rasterized too,
     which can compound the flicker (especially on Retina, where
     the image has sub-pixel positioning from the seam-fix rule
     below). Belt-and-suspenders. */
  .feature-split-angled .feature-split-image img {
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* prefers-reduced-motion: lock both edges to the FULLY-ANGLED
     silhouette. `12.28vw` is the CSS equivalent of `SLOPE × width`
     whenever the section is full-bleed (= 100vw) — which all angled
     FeatureSplits are by design. Reduced-motion users see the
     intended design state, just statically, with the same
     width-consistent 7° slope. `!important` because the script
     writes inline styles. */
  @media (prefers-reduced-motion: reduce) {
    .feature-split-angled {
      --angle-grow-top: 12.28vw !important;
      --angle-grow-bot: 12.28vw !important;
    }
  }

  /* Subpixel seam fix — full-bleed layouts only.
     On the 50/50 grid where the two cells sit flush against each other
     (default + angled variants), certain viewport widths land the cell
     boundary on a fractional pixel and the browser rounds it as a 1–2px
     gap, exposing the page bg between the image cell and the text cell.
     Wider viewports make this more visible (more sub-pixel accumulation
     across a longer 50% boundary).

     Approach: bleed the *image element* 1% wider than its cell, shifted
     0.5% left, so it overhangs each cell edge by 0.5% of cell width.
     The percentage scales with the cell so the cover holds at narrow
     and wide widths alike. On a 950px cell that's ~4.75px each side —
     plenty of sub-pixel headroom; the inner overhang still lands well
     inside the text cell's 64px `px-margin` so it doesn't visually
     touch the eyebrow or headline. The section's `overflow: hidden`
     clips the outer overhang at the page edge.

     Centerline note: cell width does NOT change. The cell boundary
     remains at exactly 50%. Only the *image element* bleeds slightly
     past each cell edge for sub-pixel seam coverage.

     `contained` variants are excluded: they have a 48px `gap-x-12`
     between cells, so there's no seam to cover. */
  .feature-split:not(.feature-split-contained) .feature-split-image img {
    left: -0.5%;
    width: 101%;
    max-width: none;
  }
</style>

<script>
  /* Angled FeatureSplit — scroll-tied "angle-grow" motion with
   * per-edge staggered windows.
   *
   * Maps each `.feature-split-angled` element's viewport progress to
   * two CSS custom properties (`--angle-grow-top`, `--angle-grow-bot`)
   * that drive the clip-path polygon defined in <style> above.
   *
   * Progress definition matches the CSS `animation-timeline: view()`
   * model — `cover 0% → cover 100%`:
   *
   *     p = (viewport.height - rect.top) / (viewport.height + rect.height)
   *
   *   p = 0  →  section's top edge is at the viewport bottom (just entering)
   *   p = 1  →  section's bottom edge is at the viewport top  (just exited)
   *   p = 0.5  →  section is roughly centred in the viewport
   *
   * Each edge gets its own active window inside `p ∈ [0, 1]`. Outside
   * its window the edge holds flat (entering window) or fully angled
   * (after window). Inside its window the edge animates from 0 to
   * `SLOPE × width` with a smoothstep ease so the transition into
   * and out of motion is gentle, not abrupt.
   *
   *   TOP_WINDOW = [0.10, 0.30]   — top develops first, 0.20 wide
   *   BOT_WINDOW = [0.35, 0.45]   — bot catches up fast, 0.10 wide (2× top's speed)
   *   easing      = 50% smoothstep — softens window boundaries without
   *                 over-accelerating through the middle of the window
   *
   * Net feel: section enters flat, holds flat through ~25% of its
   * scroll-through, top edge then commits to motion as the section
   * approaches the middle of the viewport, bottom edge follows after
   * top finishes, both then hold at full angle until the section
   * exits the viewport. The hold-then-move-then-hold pattern reads
   * as a deliberate "this is moving now" beat rather than a
   * continuous-but-imperceptible drift.
   *
   * To re-tune the stagger: edit the four boundary constants below.
   * Move TOP_START down → motion begins earlier (less hold-flat).
   * Move BOT_START up → longer pause between top finishing and bot
   * starting (slower stagger). Make windows narrower → faster
   * commit per edge. Bot can overlap top by setting BOT_START <
   * TOP_END if a less-sequential feel is wanted.
   *
   * Angle slope (SLOPE): tan(7°) ≈ 0.1228 — width-relative, so the
   * apparent angle is consistent across viewport sizes. Convenient
   * degree → slope:
   *    5° → 0.0875,  7° → 0.1228,  10° → 0.1763
   *   12° → 0.2126, 15° → 0.2679, 18° → 0.3249
   * Bump SLOPE in lockstep with the `12.28vw` in the
   * `prefers-reduced-motion` rule in <style> above.
   *
   * Performance contract:
   *   - rAF-throttled: at most one update per frame regardless of how
   *     many scroll events fire.
   *   - IntersectionObserver gates which sections are in the active
   *     set, so off-screen sections skip getBoundingClientRect every
   *     frame (free).
   *   - One scroll/resize listener total, even with N angled sections.
   *   - prefers-reduced-motion exits the script entirely.
   */
  (() => {
    const SLOPE = 0.1228; // tan(7°) — match the value in the reduced-motion CSS rule above

    // Per-edge active windows in scroll progress p ∈ [0, 1].
    // Both windows complete by p≈0.5 — by the time the section is
    // centred in the viewport, the angled silhouette is fully
    // developed.
    //
    // The bot window is half as wide as top's and starts 0.05 after
    // top ends, so there's a brief beat where top is fully angled
    // and bot is still flat (the "tug"), then bot snaps into motion
    // and catches up at ~2× top's speed. Reads as top pulling bot
    // along behind it.
    const TOP_START = 0.10;
    const TOP_END   = 0.30;
    const BOT_START = 0.35;
    const BOT_END   = 0.45;

    const remap = (p: number, start: number, end: number): number => {
      if (p <= start) return 0;
      if (p >= end) return 1;
      return (p - start) / (end - start);
    };

    // Soft ease-in-out — average of smoothstep and linear (factor 0.5).
    // Smoothstep alone (t²(3-2t)) reads as too much acceleration here;
    // pure linear has hard start/stop at the window edges. Averaging
    // them gives a curve that softens the boundaries while keeping
    // most of the motion's mid-window velocity feeling linear.
    // Identity at 0 and 1, so it composes cleanly with `remap` above.
    // Tune EASE_STRENGTH 0 (linear) → 1 (full smoothstep) to taste.
    const EASE_STRENGTH = 0.5;
    const easeInOut = (t: number): number => {
      const s = t * t * (3 - 2 * t); // smoothstep
      return t + EASE_STRENGTH * (s - t);
    };

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const sections = document.querySelectorAll<HTMLElement>('.feature-split-angled');
    if (sections.length === 0) return;

    const inView = new Set<HTMLElement>();

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) inView.add(e.target as HTMLElement);
          else inView.delete(e.target as HTMLElement);
        }
        // schedule one paint so newly-in-view sections don't lag a frame
        schedule();
      },
      { rootMargin: '0px', threshold: 0 },
    );

    sections.forEach((s) => io.observe(s));

    let rafId = 0;
    const schedule = () => {
      if (rafId) return;
      rafId = requestAnimationFrame(update);
    };

    const update = () => {
      rafId = 0;
      const vh = window.innerHeight;
      for (const el of inView) {
        const r = el.getBoundingClientRect();
        let p = (vh - r.top) / (vh + r.height);
        if (p < 0) p = 0;
        else if (p > 1) p = 1;

        // Remap raw progress into each edge's active window, then
        // smoothstep the result so the motion eases in/out at the
        // window boundaries instead of starting/stopping abruptly.
        const pTop = easeInOut(remap(p, TOP_START, TOP_END));
        const pBot = easeInOut(remap(p, BOT_START, BOT_END));

        // Width-relative depth so the slope is consistent across
        // viewport sizes — wider sections get more absolute pixels,
        // but the apparent angle stays the same 7°.
        const maxDepth = r.width * SLOPE;
        el.style.setProperty('--angle-grow-top', (pTop * maxDepth).toFixed(2) + 'px');
        el.style.setProperty('--angle-grow-bot', (pBot * maxDepth).toFixed(2) + 'px');
      }
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    // Initial paint covers sections already inside the viewport at load.
    requestAnimationFrame(update);
  })();
</script>
