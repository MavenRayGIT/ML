---
/**
 * Nav.astro — site header.
 *
 * Per HANDOFF.md → Nav — 3 States. One DOM tree, three scroll-driven
 * visual states crossfading via a `data-nav-state` attribute on the
 * root element:
 *
 *   data-nav-state="dark"   — over a dark-green section / hero photo.
 *   data-nav-state="white"  — over a white/light section (default off hero)
 *   data-nav-state="amber"  — over an amber section
 *
 * Sections opt in by setting `data-nav-bg="dark|white|amber"` on their
 * root element. A rAF-throttled scroll handler finds which section is
 * currently positioned under the nav and updates the nav state to match.
 * When no opting-in section is under the nav, state falls back to "white".
 *
 * Compact state — added 2026-05-11:
 *   `data-nav-compact="false"` only when `scrollY <= 32px` (page at top).
 *   `data-nav-compact="true"`  in every other scroll position.
 *
 *   At the very top of the page the dark state is fully TRANSPARENT so
 *   the hero photo reads straight through. As soon as the user scrolls
 *   ~32px, the nav picks up a semi-opaque green-dark bg + backdrop blur
 *   so the headline copy passing under the nav doesn't collide with
 *   the links/CTA. The logo simultaneously settles into a smaller
 *   "compact" size (desktop only — mobile already runs the small cut).
 *   White/amber states are unaffected by compact (their bg is already
 *   opaque); only the logo size responds.
 *
 *   When the user scrolls back to the very top, the compact flag flips
 *   off → bg crossfades back to transparent and the logo grows back.
 *
 * Logo swaps via opacity-crossfade between the white (over-dark) and dark
 * (over-light/amber) marks. CTA button swaps by display-toggling three
 * pre-rendered `<Button>` variants (one per state) — keeps the JS simple.
 *
 * Heights / breakpoint:
 *   The desktop nav (logo + 5 links + CTA) needs ~1033px of viewport
 *   to render without wrapping. Below that we collapse to the mobile
 *   hamburger. The breakpoint is exposed as Tailwind `nav:` via
 *   `--breakpoint-nav: 1100px` in global.css (added 2026-05-11 to fix
 *   "Support Us" wrapping + logo/links collision on narrow laptops).
 *
 *   Mobile / hamburger (< 1100px) — 56px tall, 20px gutters
 *                       (`px-margin` resolves to 20px on mobile via
 *                       global.css), 32px icon, 18px wordmark.
 *   Desktop (≥ 1100px) — 74px tall at rest, 64px gutters.
 *                       Logo at rest: 40px icon + 28px wordmark.
 *                       Compact (scrolled): nav shrinks to 56px,
 *                       logo to 32px icon + 22px wordmark, CTA
 *                       padding shrinks 24×12 → 18×8.
 *
 * Mobile (< 1100px): logo + hamburger only at rest. Tap → full amber
 * overlay with stacked nav + CTA. Body scroll locked while open.
 * Close on link tap, on the X icon, or with Escape.
 */
import Button from '../ui/Button.astro';
import { Image } from 'astro:assets';
import iconSrc        from '../../assets/logos/SO-Icon-Color-small.png';
import wordmarkLight  from '../../assets/logos/SO-logo-copy-wht-right.svg';
import wordmarkDark   from '../../assets/logos/SO-logo-dark-copy-right.svg';

const navItems = [
  { label: 'Consulting',  href: '/consulting'  },
  { label: 'Initiatives', href: '/initiatives' },
  { label: 'About',       href: '/about'       },
  { label: 'Blog',        href: '/blog'        },
  { label: 'Support Us',  href: '/support'     },
];
---

<nav
  id="site-nav"
  data-nav-state="dark"
  data-nav-compact="false"
  class="site-nav fixed inset-x-0 top-0 z-50 h-14 nav:h-[74px] transition-[background-color,backdrop-filter,color,height] duration-base ease-default"
  aria-label="Site"
>
  <div class="mx-auto flex h-full max-w-content items-center px-margin">
    {/* Logo — split into a colour tree icon (always on a cream circle so
        it reads on every nav state) + a stacked-pair wordmark that
        opacity-crossfades between the white & dark cuts. Sizes are
        driven by .nav-logo-* CSS rules below so the compact state can
        shrink them on scroll. */}
    <a href="/" class="nav-logo flex items-center gap-2 nav:gap-3" aria-label="Sustained Outcomes home">
      <span class="nav-logo-circle flex shrink-0 items-center justify-center rounded-full bg-amber">
        <Image
          src={iconSrc}
          alt=""
          width={iconSrc.width}
          height={iconSrc.height}
          class="nav-logo-icon object-contain"
        />
      </span>
      <span class="nav-logo-wordmark relative inline-block">
        <img
          src={wordmarkLight.src}
          alt=""
          aria-hidden="true"
          class="logo logo-light h-full w-auto transition-opacity duration-base ease-default"
        />
        <img
          src={wordmarkDark.src}
          alt="Sustained Outcomes"
          class="logo logo-dark absolute inset-0 h-full w-auto transition-opacity duration-base ease-default"
        />
      </span>
    </a>

    {/* Desktop links + CTA — only shown ≥ 1100px (see --breakpoint-nav) */}
    <ul class="ml-auto hidden items-center gap-8 nav:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="nav-link font-body text-nav transition-colors duration-base ease-default"
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="ml-4">
        {/* CTA — three pre-rendered variants; CSS shows the one matching nav state */}
        <span class="nav-cta nav-cta--dark">
          <Button variant="outline" surface="dark" href="/contact">Request a meeting</Button>
        </span>
        <span class="nav-cta nav-cta--white">
          <Button variant="outline-emph" href="/contact">Request a meeting</Button>
        </span>
        <span class="nav-cta nav-cta--amber">
          <Button variant="outline" surface="amber" href="/contact">Request a meeting</Button>
        </span>
      </li>
    </ul>

    {/* Mobile hamburger — flush right at the 20px gutter, sized to the
        56px nav. Right-margin uses negative -mr-1 trick removed in
        favour of relying solely on `px-margin` from the parent.
        Visible until the `nav:` breakpoint (1100px). */}
    <button
      type="button"
      class="nav-hamburger ml-auto flex h-9 w-9 items-center justify-center nav:hidden"
      data-nav-toggle
      aria-label="Open menu"
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      <svg width="20" height="14" viewBox="0 0 22 14" fill="none" aria-hidden="true">
        <line x1="0" y1="1"  x2="22" y2="1"  stroke="currentColor" stroke-width="2" />
        <line x1="0" y1="7"  x2="22" y2="7"  stroke="currentColor" stroke-width="2" />
        <line x1="0" y1="13" x2="22" y2="13" stroke="currentColor" stroke-width="2" />
      </svg>
    </button>
  </div>
</nav>

{/* Mobile full-screen amber overlay — z above nav so it covers it */}
<div
  id="mobile-nav"
  data-nav-overlay-open="false"
  class="mobile-nav-overlay fixed inset-0 z-[60] flex flex-col bg-amber nav:hidden"
  aria-hidden="true"
>
  <div class="flex h-14 items-center justify-between px-margin">
    {/* Mobile overlay header: icon-only on white circle (wordmark dropped
        — the overlay is already obviously "the site menu"). */}
    <a href="/" class="flex h-8 items-center" aria-label="Sustained Outcomes home">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white">
        <Image
          src={iconSrc}
          alt=""
          width={iconSrc.width}
          height={iconSrc.height}
          class="h-[28px] w-[28px] object-contain"
        />
      </span>
    </a>
    <button
      type="button"
      class="flex h-9 w-9 items-center justify-center text-black"
      data-nav-close
      aria-label="Close menu"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <line x1="2"  y1="2"  x2="18" y2="18" stroke="currentColor" stroke-width="2" />
        <line x1="18" y1="2"  x2="2"  y2="18" stroke="currentColor" stroke-width="2" />
      </svg>
    </button>
  </div>

  <ul class="flex flex-1 flex-col justify-center gap-6 px-margin">
    {navItems.map((item) => (
      <li>
        <a
          href={item.href}
          class="font-display text-card tracking-tight text-black transition-colors duration-base ease-default hover:text-white"
        >
          {item.label}
        </a>
      </li>
    ))}
    <li class="mt-4">
      <Button variant="green-fill" surface="amber" href="/contact" class="w-full">Request a meeting</Button>
    </li>
  </ul>
</div>

<style>
  /* ----- State-driven colour rules ------------------------------------ */
  /* Background.
     `dark` is TRANSPARENT only at the very top of the page so the hero
     reads through cleanly. As soon as the user scrolls (compact=true),
     the dark state picks up a semi-opaque green-dark wash + backdrop
     blur so content passing under the nav doesn't collide with links.
     `white` and `amber` are always opaque so compact doesn't affect
     them. Decided 2026-05-11.

     A 1px bottom hairline appears in the compact state to anchor the
     nav against whatever's behind it without committing to a full
     drop-shadow. */
  .site-nav[data-nav-state='dark'][data-nav-compact='false'] {
    background-color: transparent;
  }
  .site-nav[data-nav-state='dark'][data-nav-compact='true'] {
    background-color: rgba(8, 57, 40, 0.88);
    backdrop-filter: blur(8px) saturate(140%);
    -webkit-backdrop-filter: blur(8px) saturate(140%);
    box-shadow: inset 0 -1px 0 rgba(242, 247, 229, 0.08);
  }
  .site-nav[data-nav-state='white'] { background-color: #ffffff;            }
  .site-nav[data-nav-state='amber'] { background-color: var(--color-amber); }

  /* Logo circle is amber by default (set on the span as `bg-amber`) — it
     reads cleanly against transparent/dark photo heroes and against the
     scrolled white nav state. On the amber nav state itself the amber
     circle would melt into the bar, so swap to white there so the tree
     icon keeps a clear ground. Background swap eases in lockstep with
     the rest of the nav so the whole bar settles as one motion. */
  .site-nav[data-nav-state='amber'] .nav-logo-circle {
    background-color: #ffffff;
  }
  .site-nav[data-nav-state='white'][data-nav-compact='true'] {
    box-shadow: 0 1px 0 rgba(2, 3, 2, 0.06);
  }
  .site-nav[data-nav-state='amber'][data-nav-compact='true'] {
    box-shadow: inset 0 -1px 0 rgba(2, 3, 2, 0.08);
  }

  /* ----- Logo sizing — driven by compact state ------------------------ */
  /* All logo elements transition the same duration as the nav bg so the
     "settle on scroll" reads as one motion. Mobile keeps the small cut
     at all times (it's already compact-sized); only desktop swaps. */
  .nav-logo,
  .nav-logo-circle,
  .nav-logo-icon,
  .nav-logo-wordmark {
    transition:
      height           var(--duration-base) var(--ease-default),
      width            var(--duration-base) var(--ease-default),
      background-color var(--duration-base) var(--ease-default);
  }

  /* Mobile baseline (also compact) — 32px circle, 28px tree, 18px wordmark */
  .nav-logo                                            { height: 32px; }
  .nav-logo-circle                                     { height: 32px; width: 32px; }
  .nav-logo-icon                                       { height: 28px; width: 28px; }
  .nav-logo-wordmark                                   { height: 18px; }

  /* Desktop rest — 40px circle, 36px tree, 28px wordmark.
     Tied to --breakpoint-nav (1100px) so the chrome layout swap and
     the logo size swap happen at the same width. */
  @media (min-width: 1100px) {
    .site-nav[data-nav-compact='false'] .nav-logo            { height: 40px; }
    .site-nav[data-nav-compact='false'] .nav-logo-circle     { height: 40px; width: 40px; }
    .site-nav[data-nav-compact='false'] .nav-logo-icon       { height: 36px; width: 36px; }
    .site-nav[data-nav-compact='false'] .nav-logo-wordmark   { height: 28px; }

    /* Desktop compact — chrome + logo + CTA all shrink together as one
       motion (250ms / ease-default — same as bg + logo). Compact height
       intentionally matches the mobile 56px so we converge on a single
       "small chrome" presentation. */
    .site-nav[data-nav-compact='true']                       { height: 56px; }
    .site-nav[data-nav-compact='true']  .nav-logo            { height: 32px; }
    .site-nav[data-nav-compact='true']  .nav-logo-circle     { height: 32px; width: 32px; }
    .site-nav[data-nav-compact='true']  .nav-logo-icon       { height: 28px; width: 28px; }
    .site-nav[data-nav-compact='true']  .nav-logo-wordmark   { height: 22px; }
  }

  /* CTA padding — transitions in lockstep with the height/logo change.
     Override longhand (rather than the Tailwind `transition-colors`
     shorthand) so hover-colour transitions stay snappy at 150ms while
     padding eases at the base 250ms duration alongside the nav. */
  .site-nav .nav-cta > a,
  .site-nav .nav-cta > button {
    transition:
      background-color  var(--duration-quick) var(--ease-default),
      color             var(--duration-quick) var(--ease-default),
      border-color      var(--duration-quick) var(--ease-default),
      padding           var(--duration-base)  var(--ease-default);
  }
  @media (min-width: 1100px) {
    .site-nav[data-nav-compact='true'] .nav-cta > a,
    .site-nav[data-nav-compact='true'] .nav-cta > button {
      padding-left:  18px;
      padding-right: 18px;
      padding-top:    8px;
      padding-bottom: 8px;
    }
  }

  /* Nav-link text colour (rest) */
  .site-nav[data-nav-state='dark']  .nav-link { color: var(--color-cream); }
  .site-nav[data-nav-state='white'] .nav-link { color: var(--color-black); }
  .site-nav[data-nav-state='amber'] .nav-link { color: var(--color-black); }

  /* Nav-link hover — dark/white hover to amber (accent), amber hovers
     to white (since amber-on-amber would be invisible). Mack & Lee
     2026-05-11. */
  .site-nav[data-nav-state='dark']  .nav-link:hover { color: var(--color-amber); }
  .site-nav[data-nav-state='white'] .nav-link:hover { color: var(--color-amber); }
  .site-nav[data-nav-state='amber'] .nav-link:hover { color: #ffffff;             }

  /* Hamburger icon colour mirrors the nav-link colour */
  .site-nav[data-nav-state='dark']  .nav-hamburger { color: var(--color-cream); }
  .site-nav[data-nav-state='white'] .nav-hamburger { color: var(--color-black); }
  .site-nav[data-nav-state='amber'] .nav-hamburger { color: var(--color-black); }

  /* Logo crossfade */
  .site-nav .logo                                { will-change: opacity; }
  .site-nav[data-nav-state='dark']  .logo-light  { opacity: 1; }
  .site-nav[data-nav-state='dark']  .logo-dark   { opacity: 0; }
  .site-nav[data-nav-state='white'] .logo-light  { opacity: 0; }
  .site-nav[data-nav-state='white'] .logo-dark   { opacity: 1; }
  .site-nav[data-nav-state='amber'] .logo-light  { opacity: 0; }
  .site-nav[data-nav-state='amber'] .logo-dark   { opacity: 1; }

  /* CTA swap — render three buttons, show only the one matching state */
  .site-nav .nav-cta                                       { display: none;          }
  .site-nav[data-nav-state='dark']  .nav-cta--dark         { display: inline-block;  }
  .site-nav[data-nav-state='white'] .nav-cta--white        { display: inline-block;  }
  .site-nav[data-nav-state='amber'] .nav-cta--amber        { display: inline-block;  }

  /* Nav CTA on the dark state shares `outline × dark` with hero-body
     buttons, but the nav already sits on top of the hero gradient (and
     in the compact state on a semi-opaque green-dark wash) so the 50%
     green-dark plate that helps legibility in the hero body would
     read as a redundant pill in the nav. Strip the plate here — at
     rest AND on hover — and keep just the border-colour swap. */
  .site-nav .nav-cta--dark > a,
  .site-nav .nav-cta--dark > button,
  .site-nav .nav-cta--dark > a:hover,
  .site-nav .nav-cta--dark > button:hover {
    background-color: transparent;
  }

  /* ----- Mobile overlay ------------------------------------------------ */
  .mobile-nav-overlay {
    transform: translateY(-100%);
    transition: transform var(--duration-base, 250ms) var(--ease-out-soft, ease);
    pointer-events: none;
  }
  .mobile-nav-overlay[data-nav-overlay-open='true'] {
    transform: translateY(0);
    pointer-events: auto;
  }
</style>

<script is:inline>
  /* Nav script — runs after DOMContentLoaded because this inline tag is
     emitted *before* <main> in the document; the section targets we
     observe live further down the tree. */
  function initSiteNav() {
    /* ===== Scroll-driven nav state ===================================
       Two attributes updated per rAF tick:
         data-nav-state    — which [data-nav-bg] section is under the
                             nav probe (`dark|white|amber`)
         data-nav-compact  — true unless we're within `COMPACT_TOP_PX`
                             of the very top of the page

       The dark state is fully transparent only when not compact. As
       soon as the user scrolls past the threshold the dark state picks
       up a semi-opaque green-dark wash (see <style> above), which
       prevents the hero copy from visually colliding with the links.
       The logo simultaneously shrinks on desktop. */
    (() => {
      const nav = document.getElementById('site-nav');
      if (!nav) return;

      const COMPACT_TOP_PX = 32;

      function update() {
        const probe = nav.getBoundingClientRect().bottom + 1;
        const sections = document.querySelectorAll('[data-nav-bg]');

        let next = 'white';
        for (const section of sections) {
          const r = section.getBoundingClientRect();
          if (r.top <= probe && r.bottom > probe) {
            next = section.dataset.navBg;
            break;
          }
        }

        if (nav.dataset.navState !== next) {
          nav.dataset.navState = next;
        }

        const compact = window.scrollY > COMPACT_TOP_PX ? 'true' : 'false';
        if (nav.dataset.navCompact !== compact) {
          nav.dataset.navCompact = compact;
        }
      }

      let ticking = false;
      let settleTimer;

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        }
        // Settled-scroll reconcile — catches the final position even
        // when the rAF throttle drops the last scroll event (common on
        // Safari momentum scroll, fast wheel-flicks, and after touch
        // releases). Without this the nav can latch onto whatever state
        // was current at the previous rAF tick (e.g. white) and never
        // re-evaluate once the page comes to rest at scrollY=0. Fixed
        // 2026-05-11 after the blog-detail amber-hero bug.
        clearTimeout(settleTimer);
        settleTimer = setTimeout(update, 160);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      // `scrollend` is the most reliable signal for "scroll has truly
      // stopped" — supported in modern Chrome/Firefox/Safari. Falls
      // back gracefully (no-op) on browsers without support.
      window.addEventListener('scrollend', update);

      // Re-run once after fonts settle in case the document layout
      // shifted enough to move section boundaries past the probe.
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(update);
      }

      update();
    })();

    /* ===== Mobile overlay toggle ===================================== */
    (() => {
      const toggle = document.querySelector('[data-nav-toggle]');
      const overlay = document.getElementById('mobile-nav');
      if (!toggle || !overlay) return;

      const close = overlay.querySelector('[data-nav-close]');
      const links = overlay.querySelectorAll('a');

      function open() {
        overlay.dataset.navOverlayOpen = 'true';
        overlay.setAttribute('aria-hidden', 'false');
        toggle.setAttribute('aria-expanded', 'true');
        document.documentElement.style.overflow = 'hidden';
      }
      function dismiss() {
        overlay.dataset.navOverlayOpen = 'false';
        overlay.setAttribute('aria-hidden', 'true');
        toggle.setAttribute('aria-expanded', 'false');
        document.documentElement.style.overflow = '';
      }

      toggle.addEventListener('click', open);
      if (close) close.addEventListener('click', dismiss);
      links.forEach((a) => a.addEventListener('click', dismiss));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && overlay.dataset.navOverlayOpen === 'true') dismiss();
      });
    })();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSiteNav);
  } else {
    initSiteNav();
  }
</script>
