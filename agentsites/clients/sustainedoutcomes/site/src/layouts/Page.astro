---
/**
 * Page.astro — primary page layout.
 *
 * Composes Base.astro (which owns <html>, <head>, <body>, fonts, SEO,
 * GTM, and the reveal observer) with site chrome — Nav + Footer +
 * <main> wrapper.
 *
 * Every public page should use this layout. Dev-only / utility routes
 * that don't need site chrome can use Base.astro directly.
 *
 * Props:
 *   - All Base.astro SEO props are forwarded (title, description, etc.).
 *   - `hasHero` — when true, <main> renders without top padding so the
 *     hero sits flush against the top of the viewport (nav floats over).
 *     When false (default), main is padded down to clear the fixed nav
 *     (56px on mobile, 74px ≥ 1100px — matches Nav.astro).
 *   - `hideNav` / `hideFooter` — escape hatches for atypical pages.
 *
 * Composing pages forward arbitrary <head> content via the `head` slot.
 */
import Base from './Base.astro';
import type { ArticleMeta } from './Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import StagingBanner from '../components/layout/StagingBanner.astro';

type BaseProps = {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  lang?: string;
  articleMeta?: ArticleMeta;
};

export interface Props extends BaseProps {
  /** Set true when the page begins with a full-bleed hero. Defaults false. */
  hasHero?: boolean;
  hideNav?: boolean;
  hideFooter?: boolean;
}

const {
  hasHero = false,
  hideNav = false,
  hideFooter = false,
  ...baseProps
} = Astro.props;

// Default: render. Production deploys can suppress with the env var.
const showStagingBanner = import.meta.env.PUBLIC_HIDE_STAGING_BANNER !== 'true';

// M&L edit drawer (embed.js) — opt-in via env var so production never
// loads it. Staging CF Pages env should set:
//   PUBLIC_ML_EDIT_ENABLED=true
//   PUBLIC_ML_ADMIN_ORIGIN=https://admin.mackandlee.com  (optional override)
// The embed mounts a Shadow-DOM drawer + launcher; styles are isolated
// and the script is loaded `defer` so it can't block page paint.
const enableMlEdit = import.meta.env.PUBLIC_ML_EDIT_ENABLED === 'true';
const mlAdminOrigin =
  import.meta.env.PUBLIC_ML_ADMIN_ORIGIN ?? 'https://admin.mackandlee.com';
const mlEditSrc = enableMlEdit ? `${mlAdminOrigin}/embed.js` : null;
---

<Base {...baseProps}>
  <slot name="head" slot="head" />

  {showStagingBanner && <StagingBanner />}
  {!hideNav && <Nav />}

  {/* When no hero, pad main down so content clears the fixed nav
      (56px below --breakpoint-nav, 74px above — see Nav.astro). The
      staging banner is an overlay only — it briefly covers the top of
      the nav while visible and does not displace any chrome. */}
  <main class={!hasHero ? 'pt-14 nav:pt-[74px]' : undefined}>
    <slot />
  </main>

  {!hideFooter && <Footer />}

  {mlEditSrc && (
    <script src={mlEditSrc} data-ml-edit="sustainedoutcomes" defer></script>
  )}
  <!-- Hello from the M&L agent -->
</Base>
