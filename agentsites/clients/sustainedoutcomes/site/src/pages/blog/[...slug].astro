---
/**
 * /blog/[...slug] — blog post detail.
 *
 * Pulls every published post via `getStaticPaths` so Astro
 * pre-renders one route per post. Renders the title block, a
 * two-column article body + persistent sidebar (TOC, share, promo
 * banner), then a related-posts row.
 *
 * Layout (desktop ≥ 1024px):
 *
 *   [—— BlogDetailHero (full width inside max-w-[1100px]) ——]
 *   [—— article body ——][—— sticky sidebar ——]
 *   [—————————— BlogRelated (max-w-content) ——————————]
 *   [—————————————— CTABand ——————————————]
 *
 * Below 1024px the sidebar collapses (TOC becomes a `<details>` above
 * the article — see BlogToc.astro — share + promo move inline below
 * the body).
 *
 * Related-posts policy:
 *   - Same category as the current post, excluding self.
 *   - Up to 3 posts. If fewer than 3 in the category, top up with the
 *     next-newest posts from *other* categories so the row is always
 *     either full or empty (never half-populated, which reads
 *     accidentally sparse).
 *   - Renders nothing when there are no other posts at all.
 */

import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';

import Page             from '../../layouts/Page.astro';
import BlogDetailHero   from '../../components/blog/BlogDetailHero.astro';
import BlogToc          from '../../components/blog/BlogToc.astro';
import BlogShareButton  from '../../components/blog/BlogShareButton.astro';
import BlogPromoBanner  from '../../components/blog/BlogPromoBanner.astro';
import BlogRelated      from '../../components/blog/BlogRelated.astro';
import CTABand          from '../../components/sections/CTABand.astro';
import BlogPostingJsonLd from '../../components/seo/BlogPostingJsonLd.astro';
import siteIconRaster   from '../../assets/logos/SO-Icon-Color-small.png';

// Opt into build-time prerendering — `getStaticPaths` only works on
// prerendered routes once the project is SSR (`output: 'server'`).
// Blog detail is stable per build (posts are MDX files in the repo);
// agent edits to post content still trigger a worker rebuild via the
// content collection, which is the same cost as any SSR route.
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props:  { post },
  }));
}

interface RouteProps {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props as RouteProps;
const { Content, headings } = await render(post);

// Related posts — same category first, top up with newest from other
// categories until we have 3.
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const sameCategory = allPosts.filter((p) => p.data.category === post.data.category);
const otherCategory = allPosts.filter((p) => p.data.category !== post.data.category);

const related = [...sameCategory, ...otherCategory].slice(0, 3).map((p) => ({
  title:    p.data.title,
  excerpt:  p.data.excerpt ?? '',
  image:    p.data.image!,                       // schema validates presence per HANDOFF
  imageAlt: p.data.imageAlt ?? '',
  href:     `/blog/${p.id}`,
  category: p.data.category,
}));

const description = post.data.excerpt
  ?? `${post.data.title} — a field note from Sustained Outcomes.`;

/* ───── SEO / AIO Tier 1 ──────────────────────────────────────────────
   Everything below is auto-derived from the post frontmatter — no
   manual override surface in v1. A "Tier 2" pass (per-post seoTitle,
   keywords, updated date, noindex) is on the deferred list in
   HANDOFF.md → SEO/AIO.

   We resolve absolute URLs here (not in the components) so the
   transform pipeline is colocated with the page that owns the data. */

const siteOrigin = Astro.site ?? new URL('https://sustainedoutcomes.com');
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).toString();

// OG image — derive a 1200×630-ish JPG from the post's cover image
// when present, otherwise fall back to the site default. `getImage()`
// kicks off the same transform pipeline as the <Image /> component and
// returns the public `/_astro/` URL we can absolutise.
let ogImagePath: string | undefined;
if (post.data.image) {
  const og = await getImage({
    src: post.data.image,
    width: 1200,
    format: 'jpg',
  });
  ogImagePath = og.src;
}
const ogImageURL = ogImagePath
  ? new URL(ogImagePath, siteOrigin).toString()
  : new URL('/og-default.jpg', siteOrigin).toString();

// Publisher logo for JSON-LD — schema.org recommends a ≥112×112 raster.
// Our tree icon (SO-Icon-Color-small.png) is square and on brand;
// `getImage` outputs a hashed `/_astro/` URL we can serve absolute.
const publisherLogo = await getImage({
  src: siteIconRaster,
  width: 256,
  format: 'png',
});
const publisherLogoURL = new URL(publisherLogo.src, siteOrigin).toString();

const publishedISO = post.data.date.toISOString();
const articleMeta = {
  publishedTime: publishedISO,
  modifiedTime:  publishedISO,  // Tier 2: real `updated` field
  author:        post.data.author,
  section:       post.data.category,
  tags:          undefined,     // Tier 2: real `keywords` field
};
---

<Page
  title={`${post.data.title} — Sustained Outcomes`}
  description={description}
  ogType="article"
  ogImage={ogImageURL}
  articleMeta={articleMeta}
  hasHero
>
  <Fragment slot="head">
    <BlogPostingJsonLd
      title={post.data.title}
      description={description}
      imageUrl={ogImageURL}
      authorName={post.data.author}
      publisherLogo={publisherLogoURL}
      publishedISO={publishedISO}
      section={post.data.category}
      canonicalUrl={canonicalURL}
      siteUrl={siteOrigin.toString()}
    />
  </Fragment>
  <BlogDetailHero
    title={post.data.title}
    category={post.data.category}
    date={post.data.date}
    author={post.data.author}
    duration={post.data.duration}
    excerpt={post.data.excerpt}
    image={post.data.image}
    imageAlt={post.data.imageAlt ?? ''}
  />

  {/* ---------- Body + sidebar ---------- */}
  <section class="bg-white py-section-sm md:py-section" data-nav-bg="white">
    <div class="mx-auto grid w-full max-w-[1100px] grid-cols-1 gap-x-12 px-margin lg:grid-cols-[1fr_240px]">
      <article class="prose w-full">
        <Content />
      </article>

      {/* Whole sidebar sticks together as one block — TOC + share + promo
          all pin at `top: 96px` on desktop. Previously only the TOC was
          sticky and the lower items scrolled into it on long articles
          (fixed 2026-05-11). `align-self: start` keeps the sticky from
          stretching to grid-row height; `max-height` + overflow lets very
          long sidebars scroll internally rather than getting clipped. */}
      <aside class="blog-sidebar flex flex-col gap-8 lg:order-2 lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto lg:pr-2">
        <BlogToc headings={headings} />
        <div>
          <BlogShareButton />
        </div>
        <BlogPromoBanner
          kind="amber"
          eyebrow="Stay in touch"
          heading="Get the next post in your inbox."
          body="Short, infrequent. No tracking pixels — we'd notice."
          cta={{ text: 'Request to subscribe', href: '/contact' }}
        />
      </aside>
    </div>
  </section>

  <BlogRelated posts={related} />

  <CTABand
    eyebrow="Get in touch"
    headline="Ready to start a conversation?"
    primaryCta={{ text: 'Request a meeting', href: '/contact' }}
    secondaryCta={{ text: 'About the practice', href: '/about' }}
  />
</Page>

<style>
  /* On desktop the sidebar is the second column; on tablet/mobile it
     falls below the article. The TOC component itself handles its own
     collapsed/desktop swap — this just orders the surrounding sidebar
     block correctly. */
  @media (max-width: 1023.98px) {
    .blog-sidebar { margin-top: 3rem; }
  }
</style>
