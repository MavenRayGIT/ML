---
/**
 * Homepage placeholder.
 *
 * Step 7 replaces this with the real homepage composed from
 * the modules in MODULES.md. Until then, this placeholder
 * doubles as the smoke test for Base.astro, fonts, and tokens.
 */
import Base from '../layouts/Base.astro';
---

<Base
  title="Sustained Outcomes"
  description="Sustained Outcomes — mission-focused advisory consultancy. Full site in development."
>
  <div
    class="fixed top-0 left-0 right-0 bg-[#020302] py-2 text-center text-sm font-semibold uppercase tracking-[0.1em] text-white"
  >
    STAGING · sustainedoutcomes.mackandlee.com
  </div>

  <div class="flex min-h-screen flex-col items-center justify-center bg-gray-bg p-8">
    <main class="max-w-md text-center" data-reveal="header">
      <p class="mb-4 font-display text-eyebrow text-gray-mid">
        In development
      </p>
      <h1 class="mb-3 font-display text-4xl font-bold tracking-display">
        Sustained Outcomes
      </h1>
      <p class="font-body text-body-lg text-black/80">
        Full site build in progress. Check back soon.
      </p>
    </main>
  </div>
</Base>
